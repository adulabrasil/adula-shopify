  <ul class="product-benefits__list" role="list">
    <li class="product-benefits__item">
      <span class="product-benefits__icon" aria-hidden="true">{%- render 'icon', icon: 'picto-return', width: 24 -%}</span>
      <span>Trocas e devoluções em até <strong>7 dias</strong></span>
    </li>

    <li class="product-benefits__item">
      <span class="product-benefits__icon" aria-hidden="true">{%- render 'icon', icon: 'picto-love', width: 24 -%}</span>
      <span>Design francês, delicado e autoral</span>
    </li>

    <li class="product-benefits__item">
      <span class="product-benefits__icon" aria-hidden="true">{%- render 'icon', icon: 'picto-shield', width: 24 -%}</span>
      <span>Peças hipoalergênicas · sem níquel</span>
