<style>
  .product-benefits {
    border-block-start: 1px solid rgb(var(--text-color) / 0.14);
    padding-block-start: 1.25rem;
  }

  .product-benefits__list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
  }

  .product-benefits__item {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .product-benefits__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #b08d57;
  }

  .product-benefits__icon svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke-width: 1.4;
  }

  .product-benefits__item strong {
    color: #3a2922;
    font-weight: 600;
  }

  @media screen and (max-width: 699px) {
    .product-benefits {
      padding-block-start: 1rem;
    }

    .product-benefits__list {
      gap: 0.7rem;
    }

    .product-benefits__item {
      font-size: 0.84rem;
    }
  }
