{%- doc -%}
  This component is used in product listing and product page to render the badges of a given product.

  @param {object} product - the product to render the badges for
  @param {object} [variant] - the specific variant to show the badge from
  @param {boolean} [vertical] - if set to true, the badges are outputted vertically
  @param {string} [types] - the types of badge to output. Can be "custom", "sold_out" or "discount" (or a combination separated by comma). If nothing is set, all badges are outputted
  @param {string} [context] - can be "product" or "card"
{%- enddoc -%}

{%- liquid
  assign badge_types = types | default: 'custom, sold_out, discount' | split: ','
  assign variant = variant | default: product.selected_or_first_available_variant
  assign chic_friday_eligible = false
  assign chic_friday_tagged = false
  assign sanctuary_tagged = false
  for product_tag in product.tags
    assign normalized_tag = product_tag | strip | downcase
    if normalized_tag == 'chic friday'
      assign chic_friday_tagged = true
    elsif normalized_tag == 'santuário de paris' or normalized_tag == 'santuario de paris'
      assign sanctuary_tagged = true
    endif
  endfor
  if chic_friday_tagged and sanctuary_tagged == false and variant.compare_at_price > variant.price
    assign chic_friday_eligible = true
  endif
-%}

{%- capture badges -%}
  {%- for badge_type in badge_types -%}
    {%- assign stripped_badge_type = badge_type | strip -%}

    {%- case stripped_badge_type -%}
      {%- when 'custom' -%}
        {%- assign custom_badges = product.metafields.custom.badges.value -%}

        {%- for custom_badge in custom_badges -%}
          {%- capture customer_badge -%}{%- render 'adula-customer-media-alt', text: custom_badge -%}{%- endcapture -%}
          {%- if customer_badge != blank -%}
            <span class="badge badge--custom badge--{{ customer_badge | handle }}">{{ customer_badge | escape }}</span>
          {%- endif -%}
        {%- endfor -%}

      {%- when 'sold_out' -%}
        {%- if settings.show_sold_out_badge and variant.available == false -%}
          <sold-out-badge class="badge badge--sold-out">
            {{- 'product.general.sold_out_badge' | t -}}
          </sold-out-badge>
        {%- endif -%}

      {%- when 'discount' -%}
        {%- if settings.show_discount -%}
          {%- liquid
            assign show_on_sale_badge = false

            if context == 'product'
              if variant.compare_at_price > variant.price
                assign show_on_sale_badge = true
              endif
            elsif context == 'card'
              if product.compare_at_price > product.price
                assign show_on_sale_badge = true
              endif
            endif
          -%}

          {%- if product.compare_at_price > product.price -%}
            {%- if settings.discount_mode == 'percentage' -%}
              {%- assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | append: '%' -%}
            {%- else -%}
              {%- capture savings -%}{{ variant.compare_at_price | minus: variant.price | money }}{%- endcapture -%}
            {%- endif -%}

            {%- if show_on_sale_badge -%}
              <on-sale-badge class="badge badge--on-sale{% if chic_friday_eligible %} badge--chic-friday{% endif %}">
                {%- if chic_friday_eligible -%}
                  <span class="badge--chic-friday__text">CHIC FRIDAY</span>
                {%- else -%}
                {%- liquid
                  if context == 'product'
                    echo 'product.general.discount_badge_html' | t: savings: savings
                  elsif context == 'card'
                    if product.compare_at_price_varies or variant.compare_at_price == blank
                      echo 'product.general.on_sale_badge' | t
                    else
                      echo 'product.general.discount_badge_html' | t: savings: savings
                    endif
                  endif
                -%}
                {%- endif -%}
              </on-sale-badge>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if badges != blank -%}
  <badge-list class="badge-list {% if vertical %}badge-list--vertical{% endif %}">
    {{- badges -}}
  </badge-list>
{%- endif -%}
