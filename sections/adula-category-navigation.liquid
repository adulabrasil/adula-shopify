{%- style -%}
  #shopify-section-{{ section.id }} {
    --adula-category-ink: #4a3428;
    --adula-category-accent: #ad924f;
    --adula-category-bg: #fffdfb;
  }

  #shopify-section-{{ section.id }} .adula-category-nav {
    background: var(--adula-category-bg);
    color: var(--adula-category-ink);
    overflow: hidden;
    padding: clamp(36px, 4.2vw, 58px) 0 clamp(38px, 4.5vw, 62px);
  }

  #shopify-section-{{ section.id }} .adula-category-nav__inner {
    margin: 0 auto;
    max-width: 1440px;
    padding: 0 clamp(18px, 3vw, 42px);
  }

  #shopify-section-{{ section.id }} .adula-category-nav__heading {
    color: var(--adula-category-ink);
    font-size: clamp(23px, 2.2vw, 32px);
    font-weight: 500;
    letter-spacing: .015em;
    line-height: 1.2;
    margin: 0 0 clamp(28px, 3vw, 40px);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__heading::after {
    background: var(--adula-category-accent);
    content: "";
    display: block;
    height: 2px;
    margin: 12px auto 0;
    width: 54px;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__viewport {
    position: relative;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__list {
    display: flex;
    gap: clamp(18px, 2.7vw, 42px);
    list-style: none;
    margin: 0;
    overflow-x: auto;
    padding: 3px 4px 10px;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__list::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__item {
    flex: 0 0 clamp(128px, 14vw, 184px);
    min-width: 0;
    padding: 0;
    scroll-snap-align: start;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__link {
    color: var(--adula-category-ink);
    display: block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__media {
    aspect-ratio: 1;
    background: #f5f2ef;
    border: 1px solid rgba(173, 146, 79, .38);
    border-radius: 50%;
    box-shadow: 0 0 0 5px #fffdfb, 0 0 0 6px rgba(74, 52, 40, .10);
    margin: 7px;
    overflow: hidden;
    position: relative;
    transition: border-color .25s ease, transform .25s ease;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__media img,
  #shopify-section-{{ section.id }} .adula-category-nav__media svg {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform .45s ease;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__title {
    color: var(--adula-category-ink);
    display: block;
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 600;
    line-height: 1.35;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__link:hover .adula-category-nav__media {
    border-color: var(--adula-category-accent);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .adula-category-nav__link:hover .adula-category-nav__media img {
    transform: scale(1.045);
  }

  #shopify-section-{{ section.id }} .adula-category-nav__arrow {
    align-items: center;
    background: #fffdfb;
    border: 1px solid rgba(74, 52, 40, .14);
    border-radius: 50%;
    color: var(--adula-category-ink);
    cursor: pointer;
    display: flex;
    height: 42px;
    justify-content: center;
    padding: 0;
    position: absolute;
    top: calc(50% - 22px);
    transition: background .2s ease, border-color .2s ease;
    width: 42px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .adula-category-nav__arrow:hover {
    background: #f5f2ef;
    border-color: var(--adula-category-accent);
  }

  #shopify-section-{{ section.id }} .adula-category-nav__arrow--prev { left: -18px; }
  #shopify-section-{{ section.id }} .adula-category-nav__arrow--next { right: -18px; }

  #shopify-section-{{ section.id }} .adula-category-nav__arrow svg {
    height: 17px;
    width: 17px;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .adula-category-nav__list {
      justify-content: center;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .adula-category-nav__inner {
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .adula-category-nav__list {
      gap: 20px;
      padding-right: 22px;
      scroll-snap-type: x mandatory;
    }

    #shopify-section-{{ section.id }} .adula-category-nav__item {
      flex-basis: clamp(126px, 31vw, 158px);
    }

    #shopify-section-{{ section.id }} .adula-category-nav__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .adula-category-nav__list {
      scroll-behavior: auto;
    }

    #shopify-section-{{ section.id }} .adula-category-nav__media,
    #shopify-section-{{ section.id }} .adula-category-nav__media img {
      transition: none;
    }
  }
{%- endstyle -%}

<section class="adula-category-nav" aria-labelledby="adula-category-heading-{{ section.id }}">
  <div class="adula-category-nav__inner">
    <h2 class="adula-category-nav__heading" id="adula-category-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

    <div class="adula-category-nav__viewport">
      <button class="adula-category-nav__arrow adula-category-nav__arrow--prev" type="button" aria-label="Categorias anteriores" data-category-prev>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <ul class="adula-category-nav__list" role="list" data-category-list>
        {%- for block in section.blocks -%}
          {%- assign category_collection = block.settings.collection -%}
          {%- assign category_image = block.settings.image -%}
          {%- if category_image == blank and category_collection != blank -%}
            {%- assign category_image = category_collection.image -%}
          {%- endif -%}
          {%- if category_image == blank and category_collection != blank -%}
            {%- assign category_image = category_collection.products.first.featured_image -%}
          {%- endif -%}

          {%- assign category_title = block.settings.title -%}
          {%- if category_title == blank and category_collection != blank -%}
            {%- assign category_title = category_collection.title -%}
          {%- endif -%}

          {%- assign category_url = block.settings.link -%}
          {%- if category_url == blank and category_collection != blank -%}
            {%- assign category_url = category_collection.url -%}
          {%- endif -%}

          <li class="adula-category-nav__item" {{ block.shopify_attributes }}>
            <a class="adula-category-nav__link" href="{{ category_url | default: '#' }}">
              <div class="adula-category-nav__media">
                {%- if category_image != blank -%}
                  <img
                    src="{{ category_image | image_url: width: 520 }}"
                    srcset="{{ category_image | image_url: width: 260 }} 260w, {{ category_image | image_url: width: 380 }} 380w, {{ category_image | image_url: width: 520 }} 520w"
                    sizes="(max-width: 699px) 40vw, 184px"
                    width="520"
                    height="520"
                    loading="lazy"
                    decoding="async"
                    alt="{{ category_image.alt | default: category_title | escape }}"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
              <span class="adula-category-nav__title">{{ category_title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <button class="adula-category-nav__arrow adula-category-nav__arrow--next" type="button" aria-label="Próximas categorias" data-category-next>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (() => {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionRoot) return;

    const list = sectionRoot.querySelector('[data-category-list]');
    const previous = sectionRoot.querySelector('[data-category-prev]');
    const next = sectionRoot.querySelector('[data-category-next]');
    if (!list || !previous || !next) return;

    const move = direction => {
      list.scrollBy({ left: direction * Math.max(list.clientWidth * 0.72, 260), behavior: 'smooth' });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
  })();
</script>

{% schema %}
{
  "name": "Adüla - Categorias",
  "tag": "section",
  "class": "shopify-section--adula-categories",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Navegue por Categorias"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto personalizada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nome exibido"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link personalizado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Adüla - Categorias",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
