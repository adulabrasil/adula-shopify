{%- liquid
  assign slide_count = section.blocks.size
-%}

<style>
  #shopify-section-{{ section.id }} .adula-hero-carousel {
    position: relative;
    overflow: hidden;
    color: #4a3428;
    background: #f3ece7;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__slide {
    position: relative;
    display: none;
    width: 100%;
    aspect-ratio: 1920 / 500;
    min-height: 0;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__slide.is-active {
    display: block;
    animation: adula-hero-fade-{{ section.id }} .55s ease both;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__content {
    position: absolute;
    z-index: 2;
    inset: 0 auto 0 0;
    display: flex;
    width: min(44%, 680px);
    align-items: center;
    padding: clamp(20px, 3.2vw, 58px);
    background: linear-gradient(90deg, rgba(243, 236, 231, .94) 0%, rgba(243, 236, 231, .82) 72%, rgba(243, 236, 231, 0) 100%);
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__copy {
    max-width: 500px;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__title {
    margin: 0;
    color: inherit;
    font-size: clamp(30px, 3.5vw, 56px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__text {
    margin: 18px 0 26px;
    max-width: 410px;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    padding: 0 24px;
    color: #fffdfb;
    background: #4a3428;
    font-weight: 600;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__media,
  #shopify-section-{{ section.id }} .adula-hero-carousel__media picture,
  #shopify-section-{{ section.id }} .adula-hero-carousel__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__media {
    position: absolute;
    inset: 0;
    min-height: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__media img {
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__controls {
    position: absolute;
    z-index: 3;
    right: clamp(18px, 2.5vw, 40px);
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__arrow,
  #shopify-section-{{ section.id }} .adula-hero-carousel__dot {
    border: 0;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__arrow {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    color: #4a3428;
    background: rgba(255, 253, 251, .88);
    font-size: 22px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__dots {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 11px;
    border-radius: 20px;
    background: rgba(255, 253, 251, .88);
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: 50%;
    background: rgba(74, 52, 40, .35);
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__dot[aria-current="true"] {
    width: 24px;
    border-radius: 8px;
    background: #4a3428;
  }

  #shopify-section-{{ section.id }} .adula-hero-carousel__arrow:focus-visible,
  #shopify-section-{{ section.id }} .adula-hero-carousel__dot:focus-visible,
  #shopify-section-{{ section.id }} .adula-hero-carousel__button:focus-visible,
  #shopify-section-{{ section.id }} .adula-hero-carousel__media:focus-visible {
    outline: 3px solid #ad924f;
    outline-offset: 2px;
  }

  @keyframes adula-hero-fade-{{ section.id }} {
    from { opacity: .2; }
    to { opacity: 1; }
  }

  @media (max-width: 699px) {
    #shopify-section-{{ section.id }} .adula-hero-carousel__slide { aspect-ratio: 4 / 5; }
    #shopify-section-{{ section.id }} .adula-hero-carousel__slide.is-active { display: block; }
    #shopify-section-{{ section.id }} .adula-hero-carousel__content {
      inset: auto 0 0;
      width: 100%;
      align-items: flex-end;
      padding: 42px 20px 58px;
      background: linear-gradient(0deg, rgba(243, 236, 231, .96) 0%, rgba(243, 236, 231, .82) 68%, rgba(243, 236, 231, 0) 100%);
    }
    #shopify-section-{{ section.id }} .adula-hero-carousel__media { position: absolute; inset: 0; min-height: 0; }
    #shopify-section-{{ section.id }} .adula-hero-carousel__title { font-size: clamp(36px, 11vw, 48px); }
    #shopify-section-{{ section.id }} .adula-hero-carousel__text { margin: 12px 0 20px; }
    #shopify-section-{{ section.id }} .adula-hero-carousel__controls { right: 16px; bottom: 14px; }
    #shopify-section-{{ section.id }} .adula-hero-carousel__arrow { width: 36px; height: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .adula-hero-carousel__slide.is-active { animation: none; }
  }

  .adula-home-video-carousel {
    --adula-brown: #532e1d;
    --adula-gold: #b08d57;
    padding: clamp(26px, 3vw, 42px) 0 clamp(30px, 3.5vw, 48px);
    background: #fbf8f4;
  }
  .adula-home-video-carousel__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    width: min(100% - 40px, 1440px);
    margin: 0 auto 20px;
  }
  .adula-home-video-carousel__eyebrow {
    margin: 0 0 5px;
    color: var(--adula-gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .adula-home-video-carousel__title {
    margin: 0;
    color: var(--adula-brown);
    font-size: clamp(25px, 2.4vw, 38px);
    line-height: 1.05;
  }
  .adula-home-video-carousel__nav { display: flex; gap: 9px; }
  .adula-home-video-carousel__arrow {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid rgba(83, 46, 29, .22);
    border-radius: 50%;
    color: var(--adula-brown);
    background: rgba(255,255,255,.82);
    cursor: pointer;
    font-size: 21px;
  }
  .adula-home-video-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 80px) / 5);
    gap: 20px;
    width: min(100% - 40px, 1440px);
    margin: 0 auto;
    overflow-x: auto;
    padding: 2px 0 10px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .adula-home-video-carousel__track::-webkit-scrollbar { display: none; }
  .adula-home-video-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 14;
    border-radius: 16px;
    background: #e8e0d9;
    box-shadow: 0 7px 24px rgba(68,44,31,.08);
    scroll-snap-align: start;
  }
  .adula-home-video-card::after {
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    background: linear-gradient(180deg, transparent, rgba(32,21,15,.42));
    content: '';
    pointer-events: none;
  }
  .adula-home-video-card video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .adula-home-video-card__label {
    position: absolute;
    z-index: 2;
    left: 15px;
    right: 44px;
    bottom: 14px;
    margin: 0;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.25;
  }
  .adula-home-video-card__sound {
    position: absolute;
    z-index: 3;
    right: 11px;
    bottom: 11px;
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 50%;
    color: #fff;
    background: rgba(50,34,24,.38);
    cursor: pointer;
  }
  .adula-home-video-card__sound svg { width: 15px; height: 15px; }
  @media (max-width: 999px) and (min-width: 700px) {
    .adula-home-video-carousel__track { grid-auto-columns: calc((100% - 36px) / 3); gap: 18px; }
  }
  @media (max-width: 699px) {
    .adula-home-video-carousel { padding-block: 22px 30px; }
    .adula-home-video-carousel__header { width: calc(100% - 32px); margin-bottom: 16px; }
    .adula-home-video-carousel__nav { display: none; }
    .adula-home-video-carousel__track { grid-auto-columns: 72vw; gap: 14px; width: 100%; padding-inline: 16px; scroll-padding-inline: 16px; }
    .adula-home-video-card { border-radius: 14px; }
  }
</style>

<section
  class="adula-hero-carousel"
  data-adula-hero-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.change_slides_speed | times: 1000 }}"
  aria-roledescription="carrossel"
  aria-label="Destaques Adüla"
>
  <h1 class="sr-only">Joias e semijoias com design francês</h1>
  <div class="adula-hero-carousel__slides" aria-live="polite">
    {%- for block in section.blocks -%}
      {%- liquid
        assign hero_loading = 'lazy'
        assign hero_fetchpriority = 'low'
        if forloop.first
          assign hero_loading = 'eager'
          assign hero_fetchpriority = 'high'
        endif
      -%}
      <article class="adula-hero-carousel__slide{% if forloop.first %} is-active{% endif %}" data-adula-hero-slide aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}" aria-label="{{ forloop.index }} de {{ slide_count }}" {{ block.shopify_attributes }}>
        <a class="adula-hero-carousel__media" href="{{ block.settings.link | default: '#' }}" tabindex="{% if block.settings.link == blank %}-1{% else %}0{% endif %}" aria-label="{{ block.settings.heading | escape }}">
          {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 699px)" srcset="{{ block.settings.image_mobile | image_url: width: 500 }} 500w, {{ block.settings.image_mobile | image_url: width: 700 }} 700w, {{ block.settings.image_mobile | image_url: width: 1000 }} 1000w, {{ block.settings.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{- block.settings.image | image_url: width: 2200 | image_tag: widths: '700, 1000, 1400, 1800, 2200', sizes: '100vw', loading: hero_loading, fetchpriority: hero_fetchpriority, alt: block.settings.image.alt -}}
              {%- else -%}
                {{- block.settings.image_mobile | image_url: width: 1400 | image_tag: widths: '500, 700, 1000, 1400', sizes: '100vw', loading: hero_loading, fetchpriority: hero_fetchpriority, alt: block.settings.image_mobile.alt -}}
              {%- endif -%}
            </picture>
          {%- elsif forloop.index == 1 -%}
            <img src="{{ 'adula-personalize-familia.webp' | asset_url }}" alt="Criança tocando pulseiras personalizadas no pulso da mãe" width="1362" height="2048" fetchpriority="high" decoding="async">
          {%- elsif forloop.index == 2 -%}
            <img src="{{ 'adula-fio-de-luz.webp' | asset_url }}" alt="Coleção Fios de Luz da Adüla" width="1920" height="500" loading="lazy" decoding="async">
          {%- else -%}
            <img src="{{ 'adula-love-paris.webp' | asset_url }}" alt="Coleção Amuletos de Paris da Adüla" width="1920" height="500" loading="lazy" decoding="async">
          {%- endif -%}
        </a>
      </article>
    {%- endfor -%}
  </div>
  {%- if slide_count > 1 -%}
    <div class="adula-hero-carousel__controls" aria-label="Controles do carrossel">
      <button class="adula-hero-carousel__arrow" type="button" data-adula-hero-prev aria-label="Imagem anterior">&#8249;</button>
      <div class="adula-hero-carousel__dots">
        {%- for block in section.blocks -%}
          <button class="adula-hero-carousel__dot" type="button" data-adula-hero-dot="{{ forloop.index0 }}" aria-label="Mostrar imagem {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
        {%- endfor -%}
      </div>
      <button class="adula-hero-carousel__arrow" type="button" data-adula-hero-next aria-label="Próxima imagem">&#8250;</button>
    </div>
  {%- endif -%}
</section>

<template data-adula-home-video-template>
  <section class="adula-home-video-carousel" aria-label="Adüla em movimento">
    <div class="adula-home-video-carousel__header">
      <div>
        <p class="adula-home-video-carousel__eyebrow">Chic sans effort</p>
        <h2 class="adula-home-video-carousel__title">Adüla em movimento</h2>
      </div>
      <div class="adula-home-video-carousel__nav">
        <button class="adula-home-video-carousel__arrow" type="button" data-home-video-prev aria-label="Vídeos anteriores">&#8249;</button>
        <button class="adula-home-video-carousel__arrow" type="button" data-home-video-next aria-label="Próximos vídeos">&#8250;</button>
      </div>
    </div>
    <div class="adula-home-video-carousel__track" data-home-video-track>
      {%- assign adula_video_files = 'IMG_1017_HOME_ADULA.mp4|Adula_Stories_Bastidores_Legenda_Corrigida.mp4|Adula_Sobre_Compactado.mp4|Adula_Stories_IMG_1020.mp4|Patrocinado03_Rosto_Desfocado_Reforcado.mp4' | split: '|' -%}
      {%- assign adula_video_titles = 'Conheça a Adüla|Design Francês, feito no Brasil|Chic Sans Effort|Joias com alma francesa|Pontos físicos' | split: '|' -%}
      {%- for video_file in adula_video_files -%}
        <article class="adula-home-video-card">
          <video muted loop playsinline preload="metadata" {% if forloop.first %}autoplay{% endif %}>
            <source src="{{ video_file | file_url }}" type="video/mp4">
          </video>
          <p class="adula-home-video-card__label">{{ adula_video_titles[forloop.index0] }}</p>
          <button class="adula-home-video-card__sound" type="button" data-home-video-sound aria-label="Ativar som">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m17 9 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
        </article>
      {%- endfor -%}
    </div>
  </section>
</template>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling?.previousElementSibling;
    const hero = document.querySelector('#shopify-section-{{ section.id }} [data-adula-hero-carousel]');
    if (hero) {
      const slides = [...hero.querySelectorAll('[data-adula-hero-slide]')];
      const dots = [...hero.querySelectorAll('[data-adula-hero-dot]')];
      const previous = hero.querySelector('[data-adula-hero-prev]');
      const next = hero.querySelector('[data-adula-hero-next]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeIndex = 0;
      let timer;
      let touchStartX = 0;
      const show = (index) => {
        activeIndex = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          const active = slideIndex === activeIndex;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, dotIndex) => dot.setAttribute('aria-current', dotIndex === activeIndex ? 'true' : 'false'));
      };
      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (hero.dataset.autoplay !== 'true' || reduceMotion || slides.length < 2) return;
        timer = window.setInterval(() => show(activeIndex + 1), Number(hero.dataset.interval) || 4000);
      };
      previous?.addEventListener('click', () => { show(activeIndex - 1); start(); });
      next?.addEventListener('click', () => { show(activeIndex + 1); start(); });
      dots.forEach((dot) => dot.addEventListener('click', () => { show(Number(dot.dataset.adulaHeroDot)); start(); }));
      hero.addEventListener('mouseenter', stop);
      hero.addEventListener('mouseleave', start);
      hero.addEventListener('focusin', stop);
      hero.addEventListener('focusout', start);
      hero.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
      hero.addEventListener('touchend', (event) => {
        const distance = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(distance) < 45) return;
        show(activeIndex + (distance < 0 ? 1 : -1));
        start();
      }, { passive: true });
      start();
    }

    const mountVideos = () => {
      const banner = document.querySelector('.adula-editorial-banner');
      const bannerSection = banner?.closest('.shopify-section');
      const template = document.querySelector('#shopify-section-{{ section.id }} [data-adula-home-video-template]');
      if (!bannerSection || !template || bannerSection.dataset.adulaVideosMounted === 'true') return false;

      bannerSection.dataset.adulaVideosMounted = 'true';
      bannerSection.innerHTML = '';
      bannerSection.appendChild(template.content.cloneNode(true));

      const carousel = bannerSection.querySelector('.adula-home-video-carousel');
      const track = carousel?.querySelector('[data-home-video-track]');
      const videos = [...carousel?.querySelectorAll('video') || []];
      const cards = [...carousel?.querySelectorAll('.adula-home-video-card') || []];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      carousel?.querySelector('[data-home-video-prev]')?.addEventListener('click', () => {
        const card = cards[0]; if (!card || !track) return;
        track.scrollBy({ left: -(card.offsetWidth + 20), behavior: reduceMotion ? 'auto' : 'smooth' });
      });
      carousel?.querySelector('[data-home-video-next]')?.addEventListener('click', () => {
        const card = cards[0]; if (!card || !track) return;
        track.scrollBy({ left: card.offsetWidth + 20, behavior: reduceMotion ? 'auto' : 'smooth' });
      });
      carousel?.querySelectorAll('[data-home-video-sound]').forEach((button) => {
        button.addEventListener('click', () => {
          const video = button.closest('.adula-home-video-card')?.querySelector('video');
          if (!video) return;
          const shouldUnmute = video.muted;
          videos.forEach((item) => { item.muted = true; });
          video.muted = !shouldUnmute;
          button.setAttribute('aria-label', video.muted ? 'Ativar som' : 'Desativar som');
        });
      });
      return true;
    };

    if (!mountVideos()) {
      const observer = new MutationObserver(() => { if (mountVideos()) observer.disconnect(); });
      observer.observe(document.documentElement, { childList: true, subtree: true });
      window.setTimeout(() => observer.disconnect(), 5000);
    }
  })();
</script>

{% schema %}
{
  "name": "Carrossel Adüla",
  "tag": "section",
  "class": "shopify-section--adula-hero-carousel",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Trocar imagens automaticamente", "default": true },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 8, "step": 1, "unit": "s", "label": "Tempo entre imagens", "default": 4 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Imagem",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem desktop" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
        { "type": "text", "id": "eyebrow", "label": "Texto pequeno" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Destaque Adüla" },
        { "type": "richtext", "id": "text", "label": "Descrição" },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Conheça" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Carrossel Adüla", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
