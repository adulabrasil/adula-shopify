{%- liquid
  assign has_custom_video = false
  for block in section.blocks
    if block.settings.video != blank
      assign has_custom_video = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} .adula-video-hero {
    --adula-brown: #532e1d;
    --adula-gold: #b08d57;
    --adula-cream: #fbf8f4;
    position: relative;
    overflow: hidden;
    background: var(--adula-cream);
    padding: clamp(24px, 3vw, 42px) 0 clamp(28px, 3.6vw, 52px);
  }

  #shopify-section-{{ section.id }} .adula-video-hero__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    width: min(100% - 40px, 1440px);
    margin: 0 auto clamp(18px, 2vw, 28px);
  }

  #shopify-section-{{ section.id }} .adula-video-hero__eyebrow {
    margin: 0 0 6px;
    color: var(--adula-gold);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__title {
    margin: 0;
    color: var(--adula-brown);
    font-size: clamp(25px, 2.4vw, 38px);
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__nav {
    display: flex;
    gap: 9px;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__arrow {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(83, 46, 29, .22);
    border-radius: 50%;
    color: var(--adula-brown);
    background: rgba(255, 255, 255, .78);
    cursor: pointer;
    font-size: 21px;
    transition: background .18s ease, color .18s ease, transform .18s ease;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__arrow:hover {
    color: #fff;
    background: var(--adula-brown);
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .adula-video-hero__viewport {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__track {
    display: grid;
    grid-auto-columns: minmax(190px, 1fr);
    grid-auto-flow: column;
    gap: clamp(12px, 1.25vw, 20px);
    width: min(100% - 40px, 1440px);
    margin: 0 auto;
    overflow-x: auto;
    padding: 2px 0 12px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .adula-video-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 9 / 14;
    border-radius: 16px;
    background: #e8e0d9;
    box-shadow: 0 7px 24px rgba(68, 44, 31, .08);
    scroll-snap-align: start;
    transform: translateZ(0);
  }

  #shopify-section-{{ section.id }} .adula-video-card::after {
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(32, 21, 15, .42));
    content: '';
  }

  #shopify-section-{{ section.id }} .adula-video-card video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s ease;
  }

  #shopify-section-{{ section.id }} .adula-video-card:hover video {
    transform: scale(1.018);
  }

  #shopify-section-{{ section.id }} .adula-video-card__label {
    position: absolute;
    z-index: 2;
    left: 16px;
    right: 48px;
    bottom: 15px;
    margin: 0;
    color: #fff;
    font-size: clamp(12px, 1vw, 15px);
    font-weight: 500;
    letter-spacing: .035em;
    line-height: 1.25;
    text-shadow: 0 1px 8px rgba(0, 0, 0, .2);
  }

  #shopify-section-{{ section.id }} .adula-video-card__sound {
    position: absolute;
    z-index: 3;
    right: 12px;
    bottom: 12px;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .65);
    border-radius: 50%;
    color: #fff;
    background: rgba(50, 34, 24, .38);
    cursor: pointer;
    backdrop-filter: blur(5px);
  }

  #shopify-section-{{ section.id }} .adula-video-card__sound svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: 5px;
  }

  #shopify-section-{{ section.id }} .adula-video-hero__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(83, 46, 29, .28);
  }

  #shopify-section-{{ section.id }} .adula-video-hero__dot.is-active {
    background: var(--adula-brown);
  }

  @media (min-width: 1000px) {
    #shopify-section-{{ section.id }} .adula-video-hero__track {
      grid-auto-columns: calc((100% - (4 * clamp(12px, 1.25vw, 20px))) / 5);
    }
  }

  @media (min-width: 700px) and (max-width: 999px) {
    #shopify-section-{{ section.id }} .adula-video-hero__track {
      grid-auto-columns: calc((100% - 24px) / 3);
    }
  }

  @media (max-width: 699px) {
    #shopify-section-{{ section.id }} .adula-video-hero {
      padding-block: 22px 30px;
    }

    #shopify-section-{{ section.id }} .adula-video-hero__header {
      width: min(100% - 32px, 1440px);
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .adula-video-hero__nav {
      display: none;
    }

    #shopify-section-{{ section.id }} .adula-video-hero__track {
      grid-auto-columns: 72vw;
      width: 100%;
      padding-inline: 16px;
      scroll-padding-inline: 16px;
    }

    #shopify-section-{{ section.id }} .adula-video-card {
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .adula-video-hero__track {
      scroll-behavior: auto;
    }

    #shopify-section-{{ section.id }} .adula-video-card video {
      transition: none;
    }
  }
</style>

<section class="adula-video-hero" data-adula-video-hero aria-label="Vídeos Adüla">
  <div class="adula-video-hero__header">
    <div>
      <p class="adula-video-hero__eyebrow">{{ section.settings.eyebrow | default: 'Chic sans effort' }}</p>
      <h1 class="adula-video-hero__title">{{ section.settings.heading | default: 'Adüla em movimento' }}</h1>
    </div>

    <div class="adula-video-hero__nav" aria-label="Navegação do carrossel">
      <button class="adula-video-hero__arrow" type="button" data-adula-video-prev aria-label="Vídeos anteriores">&#8249;</button>
      <button class="adula-video-hero__arrow" type="button" data-adula-video-next aria-label="Próximos vídeos">&#8250;</button>
    </div>
  </div>

  <div class="adula-video-hero__viewport">
    <div class="adula-video-hero__track" data-adula-video-track>
      {%- if has_custom_video -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.video != blank -%}
            <article class="adula-video-card" data-adula-video-card {{ block.shopify_attributes }}>
              {{- block.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '700x' -}}
              {%- if block.settings.title != blank -%}<p class="adula-video-card__label">{{ block.settings.title }}</p>{%- endif -%}
              <button class="adula-video-card__sound" type="button" data-adula-video-sound aria-label="Ativar som">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m17 9 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_titles = 'Conheça a Adüla|Design Francês, feito no Brasil|Chic Sans Effort|Joias com alma francesa|Pontos físicos' | split: '|' -%}
        {%- assign fallback_files = 'IMG_1017_HOME_ADULA.mp4|Adula_Stories_Bastidores_Legenda_Corrigida.mp4|Adula_Sobre_Compactado.mp4|Adula_Stories_IMG_1020.mp4|Patrocinado03_Rosto_Desfocado_Reforcado.mp4' | split: '|' -%}
        {%- for file_name in fallback_files -%}
          <article class="adula-video-card" data-adula-video-card>
            <video muted loop playsinline preload="metadata" {% if forloop.first %}autoplay{% endif %}>
              <source src="{{ file_name | file_url }}" type="video/mp4">
            </video>
            <p class="adula-video-card__label">{{ fallback_titles[forloop.index0] }}</p>
            <button class="adula-video-card__sound" type="button" data-adula-video-sound aria-label="Ativar som">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m17 9 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="adula-video-hero__dots" data-adula-video-dots aria-hidden="true"></div>
</section>

<script>
  (() => {
    const sectionRoot = document.currentScript.previousElementSibling;
    if (!sectionRoot?.matches('[data-adula-video-hero]')) return;

    const track = sectionRoot.querySelector('[data-adula-video-track]');
    const cards = [...sectionRoot.querySelectorAll('[data-adula-video-card]')];
    const prev = sectionRoot.querySelector('[data-adula-video-prev]');
    const next = sectionRoot.querySelector('[data-adula-video-next]');
    const dotsRoot = sectionRoot.querySelector('[data-adula-video-dots]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!track || !cards.length) return;

    const videos = cards.map((card) => card.querySelector('video')).filter(Boolean);

    cards.forEach((card, index) => {
      const dot = document.createElement('span');
      dot.className = `adula-video-hero__dot${index === 0 ? ' is-active' : ''}`;
      dotsRoot?.appendChild(dot);

      const sound = card.querySelector('[data-adula-video-sound]');
      const video = card.querySelector('video');
      sound?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!video) return;
        const nextMuted = !video.muted;
        videos.forEach((item) => { item.muted = true; });
        video.muted = nextMuted;
        sound.setAttribute('aria-label', video.muted ? 'Ativar som' : 'Desativar som');
      });
    });

    const dots = [...dotsRoot?.children || []];

    const playMostVisible = () => {
      const trackBox = track.getBoundingClientRect();
      const center = trackBox.left + trackBox.width / 2;
      let bestIndex = 0;
      let bestDistance = Infinity;

      cards.forEach((card, index) => {
        const box = card.getBoundingClientRect();
        const distance = Math.abs((box.left + box.width / 2) - center);
        if (distance < bestDistance) {
          bestDistance = distance;
          bestIndex = index;
        }
      });

      videos.forEach((video) => {
        if (!video) return;
        video.pause();
      });

      const activeVideo = cards[bestIndex]?.querySelector('video');
      if (activeVideo && !reduceMotion) activeVideo.play().catch(() => {});
      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === bestIndex));
    };

    const scrollByCard = (direction) => {
      const card = cards[0];
      if (!card) return;
      const gap = parseFloat(getComputedStyle(track).columnGap || 0);
      track.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    prev?.addEventListener('click', () => scrollByCard(-1));
    next?.addEventListener('click', () => scrollByCard(1));

    let raf = null;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(playMostVisible);
    }, { passive: true });

    const visibilityObserver = new IntersectionObserver((entries) => {
      const visible = entries.some((entry) => entry.isIntersecting);
      if (visible) playMostVisible();
      else videos.forEach((video) => video?.pause());
    }, { threshold: .15 });
    visibilityObserver.observe(sectionRoot);

    playMostVisible();
  })();
</script>

{% schema %}
{
  "name": "Carrossel de vídeos Adüla",
  "tag": "section",
  "class": "shopify-section--adula-video-hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno",
      "default": "Chic sans effort"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Adüla em movimento"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproduzir vídeo em destaque automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Compatibilidade com configuração anterior",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Vídeo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Legenda",
          "default": "Adüla"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link opcional"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Compatibilidade: texto pequeno"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Compatibilidade: título"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Compatibilidade: texto"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Compatibilidade: botão"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrossel de vídeos Adüla",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
