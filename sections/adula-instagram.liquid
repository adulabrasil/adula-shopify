{%- style -%}
  #shopify-section-{{ section.id }} {
    --adula-instagram-background: {{ section.settings.background_color }};
    --adula-instagram-text: {{ section.settings.text_color }};
    --adula-instagram-accent: {{ section.settings.accent_color }};
  }

  .adula-instagram {
    overflow: hidden;
    padding-block: clamp(34px, 4vw, 58px) clamp(10px, 1.5vw, 24px);
    color: var(--adula-instagram-text);
    background: var(--adula-instagram-background);
  }

  .adula-instagram__heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 20px clamp(24px, 3vw, 38px);
    color: var(--adula-instagram-text);
    font-size: clamp(22px, 2.1vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .adula-instagram__heading::before,
  .adula-instagram__heading::after {
    width: clamp(24px, 3vw, 42px);
    height: 2px;
    background: var(--adula-instagram-accent);
    content: '';
  }

  .adula-instagram__icon {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
  }

  .adula-instagram__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
  }

  .adula-instagram__post {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 1;
    background: #e9e1da;
  }

  .adula-instagram__post img,
  .adula-instagram__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .adula-instagram__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: #fff;
    border-radius: 50%;
    background: rgb(74 52 40 / .72);
  }

  .adula-instagram__badge svg {
    width: 16px;
    height: 16px;
  }

  @media (hover: hover) {
    .adula-instagram__post:hover img { transform: scale(1.035); }
  }

  @media (max-width: 699px) {
    .adula-instagram { padding-bottom: 18px; }
    .adula-instagram__heading { margin-bottom: 22px; font-size: 20px; }
    .adula-instagram__heading::before,
    .adula-instagram__heading::after { width: 20px; }
    .adula-instagram__icon { width: 24px; height: 24px; }
    .adula-instagram__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 76vw;
      gap: 4px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .adula-instagram__grid::-webkit-scrollbar { display: none; }
    .adula-instagram__post { scroll-snap-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .adula-instagram__post img { transition: none; }
  }
{%- endstyle -%}

<section class="adula-instagram" aria-labelledby="adula-instagram-title-{{ section.id }}">
  <a
    id="adula-instagram-title-{{ section.id }}"
    class="adula-instagram__heading"
    href="{{ section.settings.profile_url }}"
    target="_blank"
    rel="noopener"
    aria-label="Visite {{ section.settings.profile_name }} no Instagram"
  >
    <svg class="adula-instagram__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    </svg>
    <span>{{ section.settings.profile_name }}</span>
  </a>

  <div class="adula-instagram__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign fallback_product = section.settings.fallback_collection.products[forloop.index0]
        assign post_image = block.settings.image
        if post_image == blank and fallback_product != blank
          assign post_image = fallback_product.featured_image
        endif
        assign post_url = block.settings.post_url | default: section.settings.profile_url
      -%}
      <a
        class="adula-instagram__post"
        href="{{ post_url }}"
        target="_blank"
        rel="noopener"
        role="listitem"
        aria-label="Ver publicação {{ forloop.index }} no Instagram da Adüla"
        {{ block.shopify_attributes }}
      >
        {%- if post_image != blank -%}
          {{- post_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,900', sizes: '(max-width: 699px) 76vw, 20vw', alt: block.settings.alt_text -}}
        {%- else -%}
          {{- 'image' | placeholder_svg_tag: 'adula-instagram__placeholder' -}}
        {%- endif -%}
        <span class="adula-instagram__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
          </svg>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram Adüla",
  "tag": "section",
  "class": "shopify-section--instagram-adula",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "profile_name",
      "label": "Nome do perfil",
      "default": "@adulabrasil"
    },
    {
      "type": "url",
      "id": "profile_url",
      "label": "Link do perfil"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Coleção usada até selecionar as fotos"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#f7f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#2d2926"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor dos detalhes",
      "default": "#ad924f"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publicação",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Link da publicação"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Descrição da imagem",
          "default": "Publicação do Instagram da Adüla"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Adüla",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
