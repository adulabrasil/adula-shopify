{%- style -%}
  #shopify-section-{{ section.id }} .adula-special-grid {
    background: {{ section.settings.background }};
    padding: clamp(28px, 4vw, 56px) 0;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__inner {
    max-width: 1440px;
    padding: 0 clamp(16px, 3vw, 42px);
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__heading {
    color: #4a3428;
    font-size: clamp(24px, 2.5vw, 34px);
    text-align: center;
    margin: 0 0 26px;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 20px);
  }
  #shopify-section-{{ section.id }} .adula-special-grid__tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #eee7df;
    color: #fff;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__image,
  #shopify-section-{{ section.id }} .adula-special-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__tile:hover .adula-special-grid__image { transform: scale(1.035); }
  #shopify-section-{{ section.id }} .adula-special-grid__tile::after {
    content: "";
    position: absolute;
    inset: 48% 0 0;
    background: linear-gradient(transparent, rgba(0,0,0,.43));
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .adula-special-grid__label {
    position: absolute;
    bottom: clamp(12px, 2vw, 24px);
    left: clamp(12px, 2vw, 24px);
    right: 12px;
    z-index: 1;
    font-size: clamp(16px, 1.65vw, 25px);
    line-height: 1.2;
    font-weight: 500;
    text-shadow: 0 1px 8px rgba(0,0,0,.25);
  }
  #shopify-section-{{ section.id }} .adula-special-grid__tile:focus-visible {
    outline: 3px solid #ad924f;
    outline-offset: 3px;
  }
  @media (max-width: 699px) {
    #shopify-section-{{ section.id }} .adula-special-grid__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    #shopify-section-{{ section.id }} .adula-special-grid__label { font-size: clamp(15px, 4vw, 20px); }
  }
{%- endstyle -%}

<section class="adula-special-grid">
  <div class="adula-special-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="adula-special-grid__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="adula-special-grid__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_image = block.settings.image
          if tile_image == blank and collection != blank
            assign tile_image = collection.image
          endif
          assign tile_title = block.settings.title | default: collection.title
          assign tile_link = block.settings.link | default: collection.url
        -%}
        <a class="adula-special-grid__tile" href="{{ tile_link | default: '#' }}" aria-label="{{ tile_title | default: 'Coleção Adüla' | escape }}" {{ block.shopify_attributes }}>
          {%- if tile_image != blank -%}
            {{ tile_image | image_url: width: 1100 | image_tag: class: 'adula-special-grid__image', widths: '300, 500, 750, 1000, 1100', sizes: '(max-width: 699px) 50vw, 25vw', loading: 'lazy', alt: tile_title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'adula-special-grid__placeholder' }}
          {%- endif -%}
          {%- if tile_title != blank -%}
            <span class="adula-special-grid__label">{{ tile_title | escape }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coleções especiais Adüla",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)", "default": "Coleções especiais" },
    { "type": "color", "id": "background", "label": "Cor de fundo", "default": "#fffdfb" }
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Coleção especial",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Foto quadrada (1000 x 1000 px)" },
        { "type": "text", "id": "title", "label": "Nome exibido" },
        { "type": "url", "id": "link", "label": "Link personalizado (opcional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Coleções especiais Adüla",
      "blocks": [
        { "type": "collection_tile" },
        { "type": "collection_tile" },
        { "type": "collection_tile" },
        { "type": "collection_tile" }
      ]
    }
  ]
}
{% endschema %}