<section class="adula-mixes" style="background:{{ section.settings.background }};padding:clamp(36px,5vw,72px) 0;color:#4a3428"><div class="page-width" style="max-width:1160px;margin:auto;padding:0 24px"><div style="text-align:center;margin-bottom:30px"><p style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin:0 0 9px">{{ section.settings.eyebrow | escape }}</p><h2 style="font-size:clamp(28px,3vw,42px);font-weight:400;margin:0 0 10px">{{ section.settings.heading | escape }}</h2><div style="max-width:580px;margin:auto">{{ section.settings.description }}</div></div><div class="adula-mixes__grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">{% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}<article {{ block.shopify_attributes }}><a href="{{ item.url }}" style="color:inherit;text-decoration:none;display:block">{% if item.featured_image %}{{ item.featured_image | image_url: width: 850 | image_tag: loading: 'lazy', widths: '300,450,650,850', style: 'width:100%;height:auto;aspect-ratio:1;object-fit:contain;background:#f7f4f1' }}{% endif %}<h3 style="font-weight:400;font-size:19px;margin:13px 0 6px">{{ item.title | escape }}</h3><p style="margin:0 0 9px">{% if item.compare_at_price > item.price %}<s style="opacity:.6;margin-right:7px">{{ item.compare_at_price | money }}</s>{% endif %}{{ item.price | money }}</p><span style="font-size:12px;letter-spacing:.09em;text-transform:uppercase;border-bottom:1px solid currentColor">Conhecer o mix</span></a></article>{% endif %}{% endfor %}</div>{% if section.settings.button_link != blank %}<div style="text-align:center;margin-top:32px"><a href="{{ section.settings.button_link }}" style="color:inherit;display:inline-block;border:1px solid currentColor;padding:13px 24px;text-decoration:none;letter-spacing:.06em">{{ section.settings.button_label | escape }}</a></div>{% endif %}</div></section><style>@media(max-width:749px){#shopify-section-{{ section.id }} .adula-mixes__grid{grid-template-columns:1fr!important;max-width:440px;margin:auto}}</style>{% schema %}{"name":"Misturas Adüla","tag":"section","class":"section-adula-mixes","settings":[{"type":"text","id":"eyebrow","label":"Chamada","default":"Curadoria Adüla"},{"type":"text","id":"heading","label":"Título","default":"Misturas Adüla"},{"type":"richtext","id":"description","label":"Descrição","default":"<p>Combinações pensadas para você. Chic sans effort.</p>"},{"type":"color","id":"background","label":"Cor de fundo","default":"#fbf8f4"},{"type":"text","id":"button_label","label":"Texto do botão","default":"Descubra nossos Mixes"},{"type":"url","id":"button_link","label":"Link do botão"}],"blocks":[{"type":"mix","name":"Mix","limit":3,"settings":[{"type":"product","id":"product","label":"Produto bundle"}]}],"max_blocks":3,"presets":[{"name":"Misturas Adüla","blocks":[{"type":"mix"},{"type":"mix"},{"type":"mix"}]}]}{% endschema %}