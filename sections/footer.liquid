<style>
  #shopify-section-{{ section.id }} {
    --footer-content-justify-items: {% if section.settings.blocks.size <= 2 %}start{% else %}space-between{% endif %};
  }

  #shopify-section-{{ section.id }} .footer {
    background: #ffffff !important;
    color: #3A2922;
  }

  #shopify-section-{{ section.id }} .footer .h6 {
    color: #221b18;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .footer .text-subdued,
  #shopify-section-{{ section.id }} .footer .link-faded {
    color: #3A2922;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .footer a:hover {
    color: #B08D57;
  }

  #shopify-section-{{ section.id }} .adula-footer-security {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #3A2922;
  }

  #shopify-section-{{ section.id }} .adula-footer-security svg {
    width: 22px;
    height: 22px;
    color: #B08D57;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .footer__block-list {
      align-items: start;
      column-gap: 40px;
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="footer color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="footer__inner">
      {%- comment -%}
        ------------------------------------------------------------------------------------------------------------------
        FOOTER BLOCKS (MAIN CONTENT)
        ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if section.blocks.size > 0 -%}
        <div class="footer__block-list">
          {%- assign accordion_group_content = '' -%}

          {%- for block in section.blocks -%}
            {%- capture block_content -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {%- render block -%}

                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    {%- capture sizes -%}{{ block.settings.image_width }}px{%- endcapture -%}
                    {%- capture widths -%}{{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 | at_most: block.settings.image.width }}{%- endcapture -%}
                    {%- capture style -%}--image-max-width: {{ block.settings.image_width }}px{%- endcapture -%}

                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}">
                        {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}
                      </a>
                    {%- else -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'text' -%}
                  {%- if block.settings.title != blank or block.settings.content != blank or shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                    <div class="v-stack gap-4 sm:gap-5">
                      {%- if block.settings.title != blank -%}
                        <p class="h6">{{ block.settings.title }}</p>
                      {%- endif -%}

                      {%- if block.settings.content != blank -%}
                        <div class="prose text-subdued">
                          {{- block.settings.content -}}
                        </div>
                      {%- endif -%}

                      {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                        <div class="follow-on-shop">
                          {{- shop | login_button: action: 'follow' -}}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                {%- when 'links' -%}
                  {%- assign menu = block.settings.menu -%}
                  {%- assign menu_title = block.settings.menu_title | default: menu.title -%}

                  {%- if menu_title == 'Institucional' -%}
                    {%- capture menu_content -%}
                      <ul class="v-stack gap-2.5 unstyled-list" role="list">
                        <li><a href="{% if request.page_type == 'index' %}#sobre-a-adula{% else %}{{ routes.root_url }}#sobre-a-adula{% endif %}" class="link-faded adula-section-link" data-adula-target="sobre-a-adula">Sobre a Adüla</a></li>
                        <li><a href="{% if request.page_type == 'index' %}#guia-garantia{% else %}{{ routes.root_url }}#guia-garantia{% endif %}" class="link-faded adula-section-link" data-adula-target="guia-garantia">Garantia</a></li>
                        <li><a href="{% if shop.privacy_policy != blank %}{{ shop.privacy_policy.url }}{% else %}https://www.adulabrasil.com/politica-de-privacidade{% endif %}" class="link-faded">Política de Privacidade</a></li>
                      </ul>
                    {%- endcapture -%}

                    <div class="v-stack gap-4 sm:gap-5 {% if block.settings.collapse_on_mobile %}sm-max:hidden{% endif %}">
                      {%- if block.settings.show_menu_title != blank -%}
                        <p class="h6">{{ menu_title }}</p>
                      {%- endif -%}
                      {{- menu_content -}}
                    </div>

                    {%- if block.settings.collapse_on_mobile -%}
                      {%- render 'accordion', title: menu_title, content: menu_content, class: 'sm:hidden' -%}
                    {%- endif -%}
                  {%- elsif menu != blank and menu.links.size > 0 -%}
                    {%- capture menu_content -%}
                      <ul class="v-stack gap-2.5 unstyled-list" role="list">
                        {%- for link in menu.links -%}
                          <li>
                            {%- if link.title == 'Trocas & Devoluções' or link.title == 'Trocas e Devoluções' or link.url contains '/pages/trocas-e-devolucoes' -%}
                              <a href="{% if request.page_type == 'index' %}#trocas-devolucoes{% else %}{{ routes.root_url }}#trocas-devolucoes{% endif %}" class="link-faded adula-section-link" data-adula-target="trocas-devolucoes">{{ link.title }}</a>
                            {%- elsif link.title == 'Guia de Medidas' or link.url contains '/pages/guia-de-medidas' or link.url contains '/pages/guia-de-medida' -%}
                              <a href="{% if request.page_type == 'index' %}#guia-medidas{% else %}{{ routes.root_url }}#guia-medidas{% endif %}" class="link-faded adula-section-link" data-adula-target="guia-medidas">{{ link.title }}</a>
                            {%- else -%}
                              <a href="{{ link.url }}" class="link-faded">{{ link.title }}</a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endcapture -%}

                    <div class="v-stack gap-4 sm:gap-5 {% if block.settings.collapse_on_mobile %}sm-max:hidden{% endif %}">
                      {%- if block.settings.show_menu_title != blank -%}
                        <p class="h6">{{ menu_title }}</p>
                      {%- endif -%}
                      {{- menu_content -}}
                    </div>

                    {%- if block.settings.collapse_on_mobile -%}
                      {%- render 'accordion', title: menu_title, content: menu_content, class: 'sm:hidden' -%}
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'newsletter' -%}
                  <div class="v-stack gap-4 sm:gap-5">
                    {%- if block.settings.title != blank -%}
                      <p class="h6">{{ block.settings.title }}</p>
                    {%- endif -%}

                    {%- if block.settings.content != blank -%}
                      <div class="prose text-subdued">
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}

                    {%- assign newsletter_form_id = 'newsletter-form-' | append: section.id -%}

                    {%- form 'customer', id: newsletter_form_id, class: 'form' -%}
                      {%- if form.posted_successfully? -%}
                        {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
                        {%- render 'banner', content: success_message, status: 'success' -%}
                      {%- else -%}
                        {%- if form.errors -%}
                          {%- capture error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
                          {%- render 'banner', content: error_message, status: 'error' -%}
                        {%- endif -%}

                        <input type="hidden" name="contact[tags]" value="newsletter">

                        {%- assign input_label = 'general.newsletter.email' | t -%}
                        {%- render 'input', name: 'contact[email]', label: input_label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send' -%}

                        <div class="align-self-start">
                          {%- assign button_label = 'general.newsletter.subscribe' | t -%}
                          {%- render 'button', type: 'submit', content: button_label, background: block.settings.button_background, text_color: block.settings.button_text_color -%}
                        </div>
                      {%- endif -%}
                    {%- endform -%}
                  </div>

              {%- endcase -%}
            {%- endcapture -%}

            {%- if block_content != blank -%}
              {%- liquid
                assign collapse_block = false

                if block.type == 'links' and block.settings.collapse_on_mobile
                  assign collapse_block = true
                endif
              -%}

              {%- capture current_block -%}
                <div class="footer__block footer__block--{{ block.type | remove_first: '@' }}" {{ block.shopify_attributes }}>
                  {{- block_content -}}
                </div>
              {%- endcapture -%}

              {%- if collapse_block -%}
                {%- assign accordion_group_content = accordion_group_content | append: current_block -%}
              {%- else -%}
                {%- if accordion_group_content != blank -%}
                  <div class="footer__accordion-group accordion-group">
                    {{- accordion_group_content -}}
                  </div>
                  {%- assign accordion_group_content = '' -%}
                {%- endif -%}

                {{- current_block -}}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if accordion_group_content != blank -%}
            <div class="footer__accordion-group accordion-group">
              {{- accordion_group_content -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        ------------------------------------------------------------------------------------------------------------------
        FOOTER SOCIAL MEDIA
        ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="adula-footer-social-proof">
        {%- if section.settings.show_social_media -%}
          {%- render 'social-media', layout: 'list' -%}
        {%- endif -%}

        <div class="adula-google-footer-badge" aria-label="Excelente: 5 estrelas e 6.456 avaliações das lojas Adüla no Google">
          <div class="adula-google-footer-line">
            <strong>EXCELENTE</strong>
            <span class="adula-google-footer-stars" aria-label="5 estrelas">★★★★★</span>
          </div>
          <div class="adula-google-footer-line">
            <strong data-google-footer-count>6.456 avaliações</strong>
            <span class="adula-google-footer-wordmark" aria-label="Google"><span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span></span>
          </div>
        </div>
      </div>

      <style>
        #shopify-section-{{ section.id }} .footer__inner {
          row-gap: 24px;
        }

        #shopify-section-{{ section.id }} .adula-footer-social-proof {
          display: grid;
          justify-items: start;
          gap: 12px;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-badge {
          width: max-content;
          max-width: 100%;
          margin-top: 0;
          padding: 15px 22px 16px;
          border-radius: 13px;
          background: #fff;
          color: #111;
          font-family: Arial, Helvetica, sans-serif;
          box-sizing: border-box;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-line {
          display: flex;
          align-items: center;
          gap: 8px;
          white-space: nowrap;
          line-height: 1.2;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-line + .adula-google-footer-line {
          margin-top: 2px;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-line strong {
          font-size: 15px;
          font-weight: 700;
          letter-spacing: 0;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-stars {
          color: #ffc107;
          font-size: 21px;
          letter-spacing: 0;
          line-height: 1;
        }

        #shopify-section-{{ section.id }} .adula-google-footer-wordmark {
          font-size: 22px;
          font-weight: 500;
          letter-spacing: -1px;
          line-height: 1;
        }

        #shopify-section-{{ section.id }} .g-blue { color: #4285f4; }
        #shopify-section-{{ section.id }} .g-red { color: #ea4335; }
        #shopify-section-{{ section.id }} .g-yellow { color: #fbbc05; }
        #shopify-section-{{ section.id }} .g-green { color: #34a853; }

        @media screen and (max-width: 699px) {
          #shopify-section-{{ section.id }} .adula-google-footer-badge {
            padding: 14px 18px 15px;
          }

          #shopify-section-{{ section.id }} .adula-google-footer-line strong {
            font-size: 14px;
          }

          #shopify-section-{{ section.id }} .adula-google-footer-stars {
            font-size: 19px;
          }

          #shopify-section-{{ section.id }} .adula-google-footer-wordmark {
            font-size: 21px;
          }
        }
      </style>

      <script>
        (() => {
          const minimumCount = 6456;
          const countNode = document.querySelector('#shopify-section-{{ section.id }} [data-google-footer-count]');
          if (!countNode) return;

          const formatNumber = (value) => new Intl.NumberFormat('pt-BR').format(value);
          const renderCount = (value) => {
            const parsed = Number.parseInt(value, 10);
            const count = Number.isFinite(parsed) ? Math.max(minimumCount, parsed) : minimumCount;
            countNode.textContent = formatNumber(count) + ' avaliações';
          };

          try {
            renderCount(window.localStorage.getItem('adulaGoogleReviewCount'));
          } catch (error) {
            renderCount(minimumCount);
          }

          window.addEventListener('adula:google-review-count', (event) => {
            renderCount(event.detail && event.detail.count);
          });
        })();
      </script>

      {%- comment -%}
        ------------------------------------------------------------------------------------------------------------------
        FOOTER ASIDE (COPYRIGHT + LOCALIZATION SELECTORS + PAYMENT METHODS)
        ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- capture policy_links -%}
        {%- if shop.shipping_policy != blank -%}
          <li><a href="{{ shop.shipping_policy.url }}" class="link-faded">Política de envio</a></li>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <li><a href="{{ shop.terms_of_service.url }}" class="link-faded">Termos de serviço</a></li>
        {%- endif -%}
      {%- endcapture -%}

      {%- if policy_links != blank -%}
        <nav aria-label="Políticas da loja">
          <ul class="h-stack wrap gap-x-5 gap-y-2 unstyled-list text-sm" role="list">
            {{- policy_links -}}
          </ul>
        </nav>
      {%- endif -%}

      <div class="footer__aside">
        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- assign show_country_selector = true -%}
        {%- endif -%}

        {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
          {%- assign show_locale_selector = true -%}
        {%- endif -%}

        {%- if show_country_selector or show_locale_selector -%}
          <div class="localization-selectors">
            {%- if show_country_selector -%}
              {%- render 'localization-selector',
                type: 'country',
                placement: 'top-start',
                show_country_name: section.settings.show_country_name,
                show_country_flag: section.settings.show_country_flag
              -%}
            {%- endif -%}

            {%- if show_locale_selector -%}
              {%- render 'localization-selector', type: 'locale', placement: 'top-start' -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        <p class="heading text-subdued text-xxs">
          © {{ 'now' | date: '%Y' }} - {{ shop.name }}
          {%- if section.settings.show_powered_by_shopify -%}{{ powered_by_link }}{%- endif -%}
        </p>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="v-stack gap-2">
            <p class="heading text-subdued text-xxs">Pagamento</p>
            <ul class="payment-methods unstyled-list" aria-label="Formas de pagamento aceitas">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{- type | payment_type_svg_tag -}}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.show_security_badge -%}
          <div class="v-stack gap-2">
            <p class="heading text-subdued text-xxs">Segurança</p>
            <div class="adula-footer-security" aria-label="Ambiente seguro com SSL">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="4.5" y="10" width="15" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 14v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span class="text-sm">Ambiente protegido por SSL</span>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const footer = document.currentScript.closest('.shopify-section--footer');
    const institutionalIds = ['sobre-a-adula', 'guia-garantia', 'trocas-devolucoes', 'guia-medidas'];

    const revealInstitutionalSection = (targetId, shouldScroll = true) => {
      const target = document.getElementById(targetId);
      if (!target) return false;

      institutionalIds.forEach((id) => {
        document.getElementById(id)?.classList.toggle('is-visible', id === targetId);
      });

      if (shouldScroll) {
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      return true;
    };

    const revealFromHash = () => {
      const targetId = window.location.hash.slice(1);
      if (institutionalIds.includes(targetId)) {
        revealInstitutionalSection(targetId);
      }
    };

    footer?.querySelectorAll('.adula-section-link').forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.dataset.adulaTarget;

        if (!revealInstitutionalSection(targetId)) return;

        event.preventDefault();
        history.replaceState(null, '', '#' + targetId);
      });
    });

    revealFromHash();
    window.addEventListener('hashchange', revealFromHash);

    })();

    /* Move wishlist button in product title */
    document.addEventListener('DOMContentLoaded', () => {
      window.Maestrooo?.moveProductPageButton({
        target: '.shopify-section--main-product .product-info__block-item[data-block-type="title"] .product-title',

        buttonSelector: '.shopify-section--main-product [id*="_block_wishlist_product_page_button_"] ooo-wl-access-button',

        useWrapper: true,
        hideMessage: true,

        cssStyle: {
          width: '100%',
          gap: '16px',
          justifyContent: 'space-between',

          '--ooo-wl-product-page-button-width': 'auto',
          '--ooo-wl-product-page-button-min-width': 'max-content',
          '--ooo-wl-product-page-button-height': '42px',
          '--ooo-wl-product-page-button-padding-inline': '14px'
        }
      });
    });
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "shopify-section--footer",
  "tag": "footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "t:sections.footer.show_social_media",
      "info": "t:sections.footer.show_social_media_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_security_badge",
      "label": "Mostrar segurança SSL",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by_shopify",
      "label": "t:sections.footer.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.localization.country_region_selector_category",
      "info": "t:global.localization.country_region_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:global.localization.show_country_region_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_name",
      "label": "t:global.localization.show_country_name",
      "default": true,
      "visible_if": "{{ section.settings.show_country_selector }}"
    },
    {
      "type": "checkbox",
      "id": "show_country_flag",
      "label": "t:global.localization.show_country_flag",
      "default": true,
      "visible_if": "{{ section.settings.show_country_selector }}"
    },
    {
      "type": "header",
      "content": "t:global.localization.language_selector_category",
      "info": "t:global.localization.language_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "t:global.localization.show_locale_selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "image",
      "name": "t:sections.footer.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:global.image.image",
          "info": "t:sections.footer.blocks.image.image_size_recommendation"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "t:global.image.width",
          "default": 150
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:global.text.link"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.heading",
          "default": "About our store"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>Use this text area to tell your customers about your brand and vision. You can change it in the theme editor.</p>"
        },
        {
          "type": "checkbox",
          "id": "enable_follow_on_shop",
          "label": "t:sections.footer.blocks.text.show_follow_on_shop",
          "info": "t:sections.footer.blocks.text.show_follow_on_shop_info",
          "default": true
        }
      ]
    },
    {
      "type": "links",
      "name": "t:sections.footer.blocks.links.name",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.links.menu",
          "info": "t:sections.footer.blocks.links.menu_info",
          "default": "footer"
        },
        {
          "type": "checkbox",
          "id": "collapse_on_mobile",
