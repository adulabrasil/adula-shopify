{%- liquid
  assign active_stories = 0
  for block in section.blocks
    if block.settings.video != blank
      assign active_stories = active_stories | plus: 1
    endif
  endfor
-%}

{%- if active_stories > 0 or request.design_mode -%}
  <section id="AdulaStories-{{ section.id }}" class="adula-stories" aria-label="{{ section.settings.heading | default: 'Adüla Stories' | escape }}">
    <div class="adula-stories__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="adula-stories__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if request.design_mode and active_stories == 0 -%}
        <div class="adula-stories__editor-placeholder">
          <strong>Adüla Stories</strong>
          <span>Selecione “Conheça a Adüla” no editor e escolha o vídeo.</span>
        </div>
      {%- endif -%}

      <div class="adula-stories__rail" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.video != blank -%}
            {%- assign story_poster = block.settings.cover | default: block.settings.video.preview_image -%}
            <div class="adula-stories__item" role="listitem" {{ block.shopify_attributes }}>
              <button
                class="adula-stories__trigger"
                type="button"
                aria-label="Assistir {{ block.settings.title | default: 'vídeo' | escape }}"
                aria-haspopup="dialog"
                data-story-open="AdulaStory-{{ section.id }}-{{ block.id }}"
              >
                <span class="adula-stories__ring">
                  <span class="adula-stories__thumb">
                    {%- if story_poster != blank -%}
                      {{- story_poster
                        | image_url: width: 360
                        | image_tag:
                          loading: 'lazy',
                          widths: '120,180,240,300,360',
                          sizes: '(max-width: 699px) 40vw, 170px',
                          class: 'adula-stories__image',
                          alt: block.settings.title
                      -}}
                    {%- endif -%}
                    <span class="adula-stories__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none"><path d="M9 7.8v8.4c0 .75.82 1.22 1.47.84l6.92-4.2a.98.98 0 0 0 0-1.68l-6.92-4.2A.98.98 0 0 0 9 7.8Z" fill="currentColor"/></svg>
                    </span>
                  </span>
                </span>
                {%- if block.settings.title != blank -%}
                  <span class="adula-stories__title">{{ block.settings.title }}</span>
                {%- endif -%}
              </button>

              <dialog class="adula-stories__dialog" id="AdulaStory-{{ section.id }}-{{ block.id }}" aria-label="{{ block.settings.title | default: 'Vídeo Adüla' | escape }}">
                <div class="adula-stories__modal">
                  <button class="adula-stories__close" type="button" aria-label="Fechar vídeo" data-story-close>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  </button>
                  {{- block.settings.video
                    | video_tag:
                      controls: true,
                      playsinline: true,
                      preload: 'none',
                      class: 'adula-stories__video',
                      image_size: '700x'
                  -}}
                </div>
              </dialog>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <style>
    #AdulaStories-{{ section.id }} {
      --adula-story-brown: #4a3428;
      --adula-story-gold: #ad924f;
      --adula-story-cream: #f7f2ed;
      padding: clamp(28px, 4vw, 50px) 0;
      background: {{ section.settings.background }};
      color: var(--adula-story-brown);
      overflow: hidden;
    }
    #AdulaStories-{{ section.id }} .adula-stories__inner { max-width: 1280px; margin: 0 auto; }
    #AdulaStories-{{ section.id }} .adula-stories__heading {
      margin: 0 20px 24px;
      color: var(--adula-story-brown);
      font-size: clamp(22px, 2.2vw, 30px);
      font-weight: 500;
      letter-spacing: .04em;
      line-height: 1.2;
      text-align: center;
    }
    #AdulaStories-{{ section.id }} .adula-stories__editor-placeholder {
      display: grid;
      gap: 6px;
      max-width: 520px;
      margin: 0 auto 18px;
      padding: 16px 20px;
      border: 1px dashed #cdbd9d;
      border-radius: 8px;
      background: #fffaf3;
      color: var(--adula-story-brown);
      text-align: center;
    }
    #AdulaStories-{{ section.id }} .adula-stories__editor-placeholder span { font-size: 13px; line-height: 1.4; }
    #AdulaStories-{{ section.id }} .adula-stories__rail {
      display: flex;
      justify-content: center;
      gap: clamp(18px, 2.7vw, 42px);
      padding: 4px 24px 8px;
    }
    #AdulaStories-{{ section.id }} .adula-stories__item {
      --adula-story-item-size: clamp(128px, 14vw, 184px);
      --adula-story-ring-size: calc(var(--adula-story-item-size) - 14px);
      flex: 0 0 var(--adula-story-item-size);
      width: var(--adula-story-item-size);
      text-align: center;
    }
    #AdulaStories-{{ section.id }} .adula-stories__trigger {
      display: grid;
      justify-items: center;
      gap: 10px;
      width: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    #AdulaStories-{{ section.id }} .adula-stories__ring {
      display: grid;
      place-items: center;
      width: var(--adula-story-ring-size);
      height: var(--adula-story-ring-size);
      padding: 3px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--adula-story-gold), #d6bf7e 48%, #6a3f2d);
      transition: transform .22s ease;
    }
    #AdulaStories-{{ section.id }} .adula-stories__thumb {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      padding: 3px;
      overflow: hidden;
      border: 2px solid {{ section.settings.background }};
      border-radius: 50%;
      background: var(--adula-story-cream);
    }
    #AdulaStories-{{ section.id }} .adula-stories__image {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }
    #AdulaStories-{{ section.id }} .adula-stories__play {
      position: absolute;
      right: 6px;
      bottom: 6px;
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
      border: 2px solid #fff;
      border-radius: 50%;
      background: var(--adula-story-gold);
      color: #fff;
      box-shadow: 0 2px 8px rgb(74 52 40 / 18%);
    }
    #AdulaStories-{{ section.id }} .adula-stories__play svg { width: 15px; height: 15px; }
    #AdulaStories-{{ section.id }} .adula-stories__title {
      display: block;
      max-width: var(--adula-story-item-size);
      font-size: clamp(14px, 1.05vw, 16px);
      font-weight: 500;
      letter-spacing: .01em;
      line-height: 1.3;
    }
    #AdulaStories-{{ section.id }} .adula-stories__trigger:focus-visible { outline: 2px solid var(--adula-story-gold); outline-offset: 5px; border-radius: 8px; }
    @media (hover: hover) {
      #AdulaStories-{{ section.id }} .adula-stories__trigger:hover .adula-stories__ring { transform: translateY(-3px); }
    }
    #AdulaStories-{{ section.id }} .adula-stories__dialog {
      width: min(430px, calc(100vw - 28px));
      max-width: none;
      max-height: 90vh;
      padding: 0;
      border: 0;
      border-radius: 14px;
      background: #15110f;
      box-shadow: 0 24px 80px rgb(0 0 0 / 35%);
      overflow: visible;
    }
    #AdulaStories-{{ section.id }} .adula-stories__dialog::backdrop { background: rgb(25 18 14 / 72%); backdrop-filter: blur(3px); }
    #AdulaStories-{{ section.id }} .adula-stories__modal { position: relative; overflow: hidden; border-radius: 14px; }
    #AdulaStories-{{ section.id }} .adula-stories__video {
      display: block;
      width: 100%;
      max-height: 88vh;
      aspect-ratio: 9 / 16;
      background: #15110f;
      object-fit: contain;
    }
    #AdulaStories-{{ section.id }} .adula-stories__close {
      position: absolute;
      z-index: 2;
      top: 12px;
      right: 12px;
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      padding: 0;
      border: 1px solid rgb(255 255 255 / 45%);
      border-radius: 50%;
      background: rgb(35 28 24 / 68%);
      color: #fff;
      cursor: pointer;
      backdrop-filter: blur(5px);
    }
    #AdulaStories-{{ section.id }} .adula-stories__close svg { width: 20px; height: 20px; }
    @media (max-width: 699px) {
      #AdulaStories-{{ section.id }} { padding: 26px 0 34px; }
      #AdulaStories-{{ section.id }} .adula-stories__heading { margin-bottom: 20px; font-size: 22px; }
      #AdulaStories-{{ section.id }} .adula-stories__rail {
        justify-content: flex-start;
        gap: 20px;
        padding: 3px 18px 8px;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: inline proximity;
        scrollbar-width: none;
      }
      #AdulaStories-{{ section.id }} .adula-stories__rail::-webkit-scrollbar { display: none; }
      #AdulaStories-{{ section.id }} .adula-stories__item {
        --adula-story-item-size: clamp(126px, 31vw, 158px);
        --adula-story-ring-size: calc(var(--adula-story-item-size) - 14px);
        width: var(--adula-story-item-size);
        flex-basis: var(--adula-story-item-size);
        scroll-snap-align: start;
      }
      #AdulaStories-{{ section.id }} .adula-stories__ring {
        width: var(--adula-story-ring-size);
        height: var(--adula-story-ring-size);
        padding: 2px;
      }
      #AdulaStories-{{ section.id }} .adula-stories__thumb { padding: 2px; }
      #AdulaStories-{{ section.id }} .adula-stories__title { max-width: var(--adula-story-item-size); font-size: 14px; }
      #AdulaStories-{{ section.id }} .adula-stories__play { right: 4px; bottom: 4px; width: 24px; height: 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      #AdulaStories-{{ section.id }} .adula-stories__ring { transition: none; }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('AdulaStories-{{ section.id }}');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const closeStory = (dialog) => {
        if (!dialog) return;
        const video = dialog.querySelector('video');
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
        if (dialog.open) dialog.close();
      };

      root.addEventListener('click', (event) => {
        const opener = event.target.closest('[data-story-open]');
        if (opener) {
          const dialog = document.getElementById(opener.dataset.storyOpen);
          if (!dialog) return;
          dialog.showModal();
          const video = dialog.querySelector('video');
          if (video) {
            video.play().catch(() => {});
          }
          return;
        }

        const closer = event.target.closest('[data-story-close]');
        if (closer) {
          closeStory(closer.closest('dialog'));
        }
      });

      root.querySelectorAll('dialog').forEach((dialog) => {
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) closeStory(dialog);
        });
        dialog.addEventListener('close', () => {
          const video = dialog.querySelector('video');
          if (video) {
            video.pause();
            video.currentTime = 0;
          }
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Adüla Stories",
  "tag": "section",
  "class": "shopify-section--adula-stories",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título da seção"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Cor de fundo",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story em vídeo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vídeo"
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Capa personalizada",
          "info": "Opcional. Se ficar vazio, usamos a capa do próprio vídeo."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Conheça a Adüla"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Adüla Stories",
      "category": "Mídia",
      "blocks": [
        {
          "type": "story"
        }
      ]
    }
  ]
}
{% endschema %}