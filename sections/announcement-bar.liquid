{%- if section.blocks.size > 0 -%}
  <style>
    :root {
      --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};

      {%- if section.index == 1 and section.settings.enable_sticky == false -%}
        --header-scroll-tracker-offset: var(--announcement-bar-height);
      {%- endif -%}
    }

    {%- if section.settings.enable_sticky -%}
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .shopify-section--header ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-is-sticky, 0) * var(--header-height, 0px));
        z-index: 4; /* We have to lower the z-index in case the announcement bar is displayed after the header */
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} {
      --announcement-bar-font-size: {{ section.settings.mobile_font_size | divided_by: 16.0 }}rem;
    }

    #shopify-section-{{ section.id }} .announcement-bar {
      padding-block: 0.72em;
      padding-inline: 0;
      background: {{ section.settings.custom_background }};
      color: {{ section.settings.custom_text_color }};
      display: block;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .announcement-bar__marquee {
      width: 100%;
      text-align: start;
      white-space: nowrap;
      user-select: none;
      display: block;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .announcement-bar__marquee::part(scroller) {
      min-width: max-content;
      display: inline-flex;
      position: relative;
    }

    #shopify-section-{{ section.id }} .announcement-bar__track {
      min-width: max-content;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .announcement-bar__message {
      padding-inline: clamp(1rem, 2.2vw, 2rem);
      letter-spacing: 0.035em;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .announcement-bar__separator {
      color: #B08D57;
      font-size: 0.9em;
      line-height: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .announcement-bar__marquee::part(scroller) {
        transform: none !important;
      }
    }

    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --announcement-bar-font-size: {{ section.settings.desktop_font_size | divided_by: 16.0 }}rem;
      }
    }
  </style>

  <height-observer variable="announcement-bar">
    <div class="announcement-bar color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <marquee-text
        speed="{{ section.settings.scrolling_speed }}"
        direction="left"
        {% if section.settings.pause_on_hover %}
          pause-on-hover
        {% endif %}
        class="announcement-bar__marquee"
      >
        <div class="announcement-bar__track">
          {%- for block in section.blocks -%}
            <p class="announcement-bar__message prose heading" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </p>
            <span class="announcement-bar__separator" aria-hidden="true">•</span>
          {%- endfor -%}
        </div>
      </marquee-text>
    </div>
  </height-observer>

  <script>
    document.documentElement.style.setProperty('--announcement-bar-height', `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`);
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "tag": "aside",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Cor de fundo da faixa",
      "default": "#AD924F"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Cor do texto da faixa",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky_bar"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "Velocidade do movimento",
      "default": 0.3
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar ao passar o mouse",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 9,
      "max": 15,
      "unit": "px",
      "label": "t:sections.announcement_bar.desktop_text_size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 9,
      "max": 15,
      "unit": "px",
      "label": "t:sections.announcement_bar.mobile_text_size",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Announce something here"
          }
        }
      ]
    }
  ]
}
{% endschema %}
