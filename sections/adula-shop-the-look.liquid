{%- style -%}
  #shopify-section-{{ section.id }} .adula-look {
    --look-brown: #4a3428;
    --look-cream: #fbf8f4;
    --look-gold: #b6925e;
    background: {{ section.settings.background }};
    color: var(--look-brown);
    padding: clamp(42px, 6vw, 86px) 0;
  }
  #shopify-section-{{ section.id }} .adula-look__inner { width: min(1220px, calc(100% - 40px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .adula-look__head { text-align: center; max-width: 680px; margin: 0 auto 32px; }
  #shopify-section-{{ section.id }} .adula-look__eyebrow { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .18em; font-size: 11px; }
  #shopify-section-{{ section.id }} .adula-look__title { margin: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1.05; font-weight: 400; }
  #shopify-section-{{ section.id }} .adula-look__text { margin: 14px auto 0; max-width: 520px; opacity: .78; }
  #shopify-section-{{ section.id }} .adula-look__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: clamp(24px, 5vw, 72px); align-items: center; }
  #shopify-section-{{ section.id }} .adula-look__visual { position: relative; overflow: hidden; background: #eee7e1; }
  #shopify-section-{{ section.id }} .adula-look__visual img { display: block; width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .adula-look__placeholder { aspect-ratio: 1 / 1; display:grid; place-items:center; padding:40px; text-align:center; }
  #shopify-section-{{ section.id }} .adula-look__hotspot { position:absolute; left:var(--x); top:var(--y); transform:translate(-50%,-50%); width:30px; height:30px; padding:0; border:1px solid rgba(255,255,255,.95); border-radius:50%; background:rgba(255,255,255,.88); box-shadow:0 2px 12px rgba(54,36,25,.22); cursor:pointer; z-index:2; transition:transform .2s ease, background .2s ease; }
  #shopify-section-{{ section.id }} .adula-look__hotspot::after { content:''; position:absolute; inset:9px; border-radius:50%; background:var(--look-gold); }
  #shopify-section-{{ section.id }} .adula-look__hotspot:hover, #shopify-section-{{ section.id }} .adula-look__hotspot.is-active { transform:translate(-50%,-50%) scale(1.14); background:#fff; }
  #shopify-section-{{ section.id }} .adula-look__product { display:none; animation:adulaLookFade .25s ease; }
  #shopify-section-{{ section.id }} .adula-look__product.is-active { display:block; }
  #shopify-section-{{ section.id }} .adula-look__product-image { display:block; width:min(100%, 320px); aspect-ratio:1/1; object-fit:cover; margin:0 auto 22px; background:#f3eee9; }
  #shopify-section-{{ section.id }} .adula-look__product-title { font-size:clamp(20px,2vw,27px); line-height:1.2; margin:0 0 8px; font-weight:400; }
  #shopify-section-{{ section.id }} .adula-look__price { margin:0 0 20px; font-size:15px; }
  #shopify-section-{{ section.id }} .adula-look__link, #shopify-section-{{ section.id }} .adula-look__all { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:0 22px; border:1px solid var(--look-brown); text-decoration:none; color:var(--look-brown); transition:.2s ease; }
  #shopify-section-{{ section.id }} .adula-look__link:hover, #shopify-section-{{ section.id }} .adula-look__all:hover { background:var(--look-brown); color:#fff; }
  #shopify-section-{{ section.id }} .adula-look__all-wrap { text-align:center; margin-top:32px; }
  @keyframes adulaLookFade { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .adula-look { padding:42px 0 50px; }
    #shopify-section-{{ section.id }} .adula-look__inner { width:min(100% - 28px, 620px); }
    #shopify-section-{{ section.id }} .adula-look__grid { grid-template-columns:1fr; gap:24px; }
    #shopify-section-{{ section.id }} .adula-look__details { text-align:center; }
    #shopify-section-{{ section.id }} .adula-look__product-image { width:min(70vw, 280px); }
    #shopify-section-{{ section.id }} .adula-look__hotspot { width:28px; height:28px; }
  }
{%- endstyle -%}

<section class="adula-look" data-adula-look>
  <div class="adula-look__inner">
    <header class="adula-look__head">
      {%- if section.settings.eyebrow != blank -%}<p class="adula-look__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="adula-look__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="adula-look__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="adula-look__grid">
      <div class="adula-look__visual">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">{%- endif -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(max-width: 749px) calc(100vw - 28px), 65vw', alt: section.settings.heading }}
          </picture>
        {%- else -%}
          <div class="adula-look__placeholder">Escolha a foto do mix no editor do tema.</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            <button class="adula-look__hotspot{% if forloop.first %} is-active{% endif %}" type="button" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;" data-look-hotspot="{{ block.id }}" aria-label="Ver {{ block.settings.product.title | escape }}" {{ block.shopify_attributes }}></button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="adula-look__details" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- assign look_product = block.settings.product -%}
          {%- if look_product != blank -%}
            <article class="adula-look__product{% if forloop.first %} is-active{% endif %}" data-look-product="{{ block.id }}">
              {%- if look_product.featured_image -%}{{ look_product.featured_image | image_url: width: 700 | image_tag: class: 'adula-look__product-image', loading: 'lazy', widths: '300,500,700', sizes: '(max-width:749px) 70vw, 320px' }}{%- endif -%}
              <h3 class="adula-look__product-title">{{ look_product.title }}</h3>
              <p class="adula-look__price">{{ look_product.price | money }}</p>
              <a class="adula-look__link" href="{{ look_product.url }}">Ver peça</a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="adula-look__all-wrap"><a class="adula-look__all" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} →</a></div>
    {%- endif -%}
  </div>
</section>

<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  if (!root || !root.matches('[data-adula-look]')) return;
  const hotspots = [...root.querySelectorAll('[data-look-hotspot]')];
  const products = [...root.querySelectorAll('[data-look-product]')];
  const activate = (id) => {
    hotspots.forEach((el) => el.classList.toggle('is-active', el.dataset.lookHotspot === id));
    products.forEach((el) => el.classList.toggle('is-active', el.dataset.lookProduct === id));
  };
  hotspots.forEach((hotspot) => hotspot.addEventListener('click', () => activate(hotspot.dataset.lookHotspot)));
})();
</script>

{% schema %}
{
  "name": "Shop the Look Adüla",
  "tag": "section",
  "class": "shopify-section--adula-shop-the-look",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Chic sans effort" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Shop the Look" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Um mix, infinitas formas de adular-se.</p>" },
    { "type": "image_picker", "id": "image", "label": "Foto do look — desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Foto do look — mobile (opcional)" },
    { "type": "color", "id": "background", "label": "Fundo", "default": "#fbf8f4" },
    { "type": "text", "id": "button_label", "label": "Texto do botão final", "default": "Explorar o Lookbook" },
    { "type": "url", "id": "button_link", "label": "Link do Lookbook" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Produto / hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Produto" },
        { "type": "range", "id": "x", "label": "Posição horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Posição vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look Adüla",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 62, "y": 16 } },
        { "type": "hotspot", "settings": { "x": 55, "y": 73 } },
        { "type": "hotspot", "settings": { "x": 48, "y": 82 } },
        { "type": "hotspot", "settings": { "x": 45, "y": 91 } }
      ]
    }
  ]
}
{% endschema %}
