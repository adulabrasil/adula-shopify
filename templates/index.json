{
  "sections": {
    "hero": {
      "type": "custom-liquid",
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "text_alignment": "center",
        "liquid": "<style>\n  .adula-campaign-hero { position: relative; display: block; overflow: hidden; color: #fffdfb; background: #b98759; }\n  .adula-campaign-hero picture, .adula-campaign-hero img { display: block; width: 100%; }\n  .adula-campaign-hero img { height: auto; }\n  .adula-campaign-hero__content { position: absolute; inset: 0; display: flex; align-items: center; padding: clamp(24px, 6vw, 96px); }\n  .adula-campaign-hero__copy { max-width: 520px; text-align: left; text-shadow: 0 1px 14px rgb(45 41 38 / 20%); }\n  .adula-campaign-hero__eyebrow { margin: 0 0 8px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; }\n  .adula-campaign-hero__title { margin: 0; color: inherit; font-size: clamp(36px, 5vw, 72px); line-height: .98; }\n  .adula-campaign-hero__text { margin: 16px 0 24px; max-width: 390px; font-size: clamp(15px, 1.4vw, 19px); }\n  .adula-campaign-hero__button { display: inline-flex; min-height: 46px; align-items: center; padding: 0 24px; color: #2d2926; background: #fffdfb; font-weight: 600; text-shadow: none; }\n  @media (max-width: 699px) {\n    .adula-campaign-hero__content { align-items: flex-end; padding: 28px 20px; background: linear-gradient(0deg, rgb(45 41 38 / 48%), transparent 52%); }\n    .adula-campaign-hero__title { font-size: clamp(34px, 11vw, 48px); }\n    .adula-campaign-hero__text { margin: 10px 0 18px; }\n  }\n</style>\n<a href=\"/collections/all\" class=\"adula-campaign-hero\" aria-label=\"Personalize sua peça na Adüla\">\n  <picture>\n    <source media=\"(max-width: 699px)\" srcset=\"{{ 'adula-hero-mobile.jpg' | asset_url }}\">\n    <img src=\"{{ 'adula-hero-desktop.jpg' | asset_url }}\" alt=\"Mãos segurando um pingente dourado da Torre Eiffel e uma bandeja de joias\" width=\"2048\" height=\"1362\" fetchpriority=\"high\" decoding=\"async\">\n  </picture>\n  <div class=\"adula-campaign-hero__content\">\n    <div class=\"adula-campaign-hero__copy\">\n      <p class=\"adula-campaign-hero__eyebrow\">Crie do seu jeito</p>\n      <h1 class=\"adula-campaign-hero__title\">Personalize sua peça</h1>\n      <p class=\"adula-campaign-hero__text\">Escolha seus símbolos favoritos e transforme memórias em uma joia única.</p>\n      <span class=\"adula-campaign-hero__button\">Personalizar agora</span>\n    </div>\n  </div>\n</a>"
      }
    },
