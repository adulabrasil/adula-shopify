        "liquid": "{%- liquid\n  assign google_rating_br = '5,0'\n  assign google_count_br = '6.456'\n-%}\n<div class=\"adula-google-reviews-summary\" aria-label=\"Avaliações das lojas Adüla no Google\" data-minimum-count=\"6456\">\n  <span class=\"adula-google-wordmark\" aria-label=\"Google\"><span class=\"g-blue\">G</span><span class=\"g-red\">o</span><span class=\"g-yellow\">o</span><span class=\"g-blue\">g</span><span class=\"g-green\">l</span><span class=\"g-red\">e</span></span>\n  <strong>Excelente</strong>\n  <strong data-google-rating>{{ google_rating_br }}</strong>\n  <span class=\"adula-google-divider\" aria-hidden=\"true\">|</span>\n  <strong data-google-count>{{ google_count_br }} avaliações</strong>\n  <span class=\"adula-google-stars\" aria-label=\"5 estrelas\">★★★★★</span>\n</div>\n<style>\n  .adula-google-reviews-summary{display:flex;align-items:center;gap:10px;min-height:58px;padding:10px 0;font-family:Arial,sans-serif;color:#161616;white-space:nowrap;overflow-x:auto}\n  .adula-google-wordmark{font-size:27px;font-weight:500;letter-spacing:-2px;margin-right:2px}\n  .adula-google-reviews-summary strong{font-size:16px}\n  .adula-google-divider{color:#777}\n  .adula-google-stars{color:#FFC107;font-size:23px;letter-spacing:1px;line-height:1}\n  .g-blue{color:#4285F4}.g-red{color:#EA4335}.g-yellow{color:#FBBC05}.g-green{color:#34A853}\n  @media(max-width:699px){.adula-google-reviews-summary{gap:7px;min-height:52px}.adula-google-wordmark{font-size:23px}.adula-google-reviews-summary strong{font-size:14px}.adula-google-stars{font-size:19px}}\n</style>\n<script>\n(function(){\n  var minimumCount = 6456;\n  var summary = document.querySelector('.adula-google-reviews-summary');\n  if (!summary) return;\n\n  function formatNumber(value) {\n    try { return Number(value).toLocaleString('pt-BR'); }\n    catch (error) { return String(value).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.'); }\n  }\n\n  function syncJudgeMeSummary() {\n    var liveCount = 0;\n    var liveRating = 0;\n    Array.prototype.forEach.call(document.scripts, function(script) {\n      var source = script.textContent || '';\n      if (source.indexOf('shop_aggregates') === -1) return;\n      var countMatch = source.match(/shop_aggregates\\s*:\\s*\\{\\s*reviewCount\\s*:\\s*(\\d+)/);\n      var ratingMatch = source.match(/averageRating\\s*=\\s*([\\d.]+)/);\n      if (countMatch) liveCount = Math.max(liveCount, parseInt(countMatch[1], 10) || 0);\n      if (ratingMatch) liveRating = Math.max(liveRating, parseFloat(ratingMatch[1]) || 0);\n    });\n    var count = Math.max(minimumCount, liveCount);\n    var countNode = summary.querySelector('[data-google-count]');\n    var ratingNode = summary.querySelector('[data-google-rating]');\n    if (countNode) countNode.textContent = formatNumber(count) + ' avaliações';\n    if (ratingNode && liveRating) ratingNode.textContent = liveRating.toFixed(1).replace('.', ',');\n\n    try {\n      window.localStorage.setItem('adulaGoogleReviewCount', String(count));\n    } catch (error) {}\n\n    window.dispatchEvent(new CustomEvent('adula:google-review-count', {\n      detail: { count: count }\n    }));\n  }\n\n  function ensureCarouselRotation() {\n    var carousel = document.querySelector('.jdgm-testimonials-carousel');\n    if (!carousel || carousel.dataset.adulaRotationGuard === '1') return;\n    carousel.dataset.adulaRotationGuard = '1';\n    var lastIndex = '';\n    var lastChangedAt = Date.now();\n\n    function currentIndex() {\n      var visible = carousel.querySelector('.jdgm-carousel-item[aria-hidden=\"false\"]');\n      return visible ? visible.getAttribute('data-card-index') || '' : '';\n    }\n\n    window.setInterval(function() {\n      var index = currentIndex();\n      if (index && index !== lastIndex) {\n        lastIndex = index;\n        lastChangedAt = Date.now();\n        return;\n      }\n      if (Date.now() - lastChangedAt < 7500) return;\n      var next = carousel.querySelector('button[aria-label=\"Next slide\"]');\n      if (next) {\n        next.click();\n        lastChangedAt = Date.now();\n      }\n    }, 1500);\n  }\n\n  function initialize() {\n    syncJudgeMeSummary();\n    ensureCarouselRotation();\n    window.setTimeout(syncJudgeMeSummary, 3000);\n    window.setTimeout(ensureCarouselRotation, 3000);\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initialize, { once: true });\n  } else {\n    initialize();\n  }\n})();\n</script>",
        "text_alignment": "start"
      }
