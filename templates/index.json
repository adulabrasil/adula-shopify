    "campaign-banners": {
      "type": "custom-liquid",
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "text_alignment": "center",
        "liquid": "{%- style -%}\n  #shopify-section-{{ section.id }} {\n    --adula-trio-gap: clamp(14px, 1.35vw, 22px);\n  }\n\n  .adula-trio-banners {\n    padding: clamp(38px, 4vw, 58px) max(20px, 5vw);\n    background: rgb(var(--background));\n  }\n\n  .adula-trio-banners__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--adula-trio-gap);\n    width: 100%;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .adula-trio-banners__item {\n    display: block;\n    min-width: 0;\n    overflow: hidden;\n    background: #f2ece8;\n    text-decoration: none;\n  }\n\n  .adula-trio-banners__image {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    transition: transform .45s ease;\n  }\n\n  .adula-trio-banners__item:focus-visible {\n    outline: 3px solid #ad924f;\n    outline-offset: 4px;\n  }\n\n  @media (hover: hover) {\n    .adula-trio-banners__item:hover .adula-trio-banners__image {\n      transform: scale(1.018);\n    }\n  }\n\n  @media (max-width: 699px) {\n    .adula-trio-banners {\n      padding: 34px 0 42px;\n      overflow: hidden;\n    }\n\n    .adula-trio-banners__grid {\n      grid-template-columns: none;\n      grid-auto-columns: minmax(278px, 84vw);\n      grid-auto-flow: column;\n      gap: 14px;\n      max-width: none;\n      padding: 0 18px 10px;\n      overflow-x: auto;\n      overscroll-behavior-inline: contain;\n      scroll-snap-type: inline mandatory;\n      scrollbar-width: none;\n    }\n\n    .adula-trio-banners__grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .adula-trio-banners__item {\n      scroll-snap-align: center;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .adula-trio-banners__image {\n      transition: none;\n    }\n  }\n{%- endstyle -%}\n\n<section class=\"adula-trio-banners\" aria-label=\"Destaques Adüla\">\n  <div class=\"adula-trio-banners__grid\">\n    <a class=\"adula-trio-banners__item\" href=\"{{ section.settings.link_1 | default: '/collections/love-paris' }}\" aria-label=\"Coleção Love Paris\">\n      {%- if section.settings.image_1 != blank -%}\n        {{ section.settings.image_1 | image_url: width: 1000 | image_tag: class: 'adula-trio-banners__image', widths: '320, 480, 640, 760, 1000', sizes: '(min-width: 700px) 33vw, 84vw', loading: 'lazy' }}\n      {%- else -%}\n        <img class=\"adula-trio-banners__image\" src=\"data:image/webp;base64,\" alt=\"Coleção Love Paris\" width=\"760\" height=\"760\" loading=\"lazy\" decoding=\"async\">\n      {%- endif -%}\n    </a>\n\n    <a class=\"adula-trio-banners__item\" href=\"{{ section.settings.link_2 | default: '/collections/dia-dos-pais' }}\" aria-label=\"Herança de pai para filho\">\n      {%- if section.settings.image_2 != blank -%}\n        {{ section.settings.image_2 | image_url: width: 1000 | image_tag: class: 'adula-trio-banners__image', widths: '320, 480, 640, 760, 1000', sizes: '(min-width: 700px) 33vw, 84vw', loading: 'lazy' }}\n      {%- else -%}\n        <img class=\"adula-trio-banners__image\" src=\"data:image/webp;base64,\" alt=\"Herança de pai para filho\" width=\"760\" height=\"760\" loading=\"lazy\" decoding=\"async\">\n      {%- endif -%}\n    </a>\n\n    <a class=\"adula-trio-banners__item\" href=\"{{ section.settings.link_3 | default: '/collections/boho-chic-2' }}\" aria-label=\"Coleção Boho Chic\">\n      {%- if section.settings.image_3 != blank -%}\n        {{ section.settings.image_3 | image_url: width: 1000 | image_tag: class: 'adula-trio-banners__image', widths: '320, 480, 640, 760, 1000', sizes: '(min-width: 700px) 33vw, 84vw', loading: 'lazy' }}\n      {%- else -%}\n        <img class=\"adula-trio-banners__image\" src=\"data:image/webp;base64,\" alt=\"Coleção Boho Chic\" width=\"760\" height=\"760\" loading=\"lazy\" decoding=\"async\">\n      {%- endif -%}\n    </a>\n  </div>\n</section>"
      }
    }
